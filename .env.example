# Copy to .env. Never commit .env.
# Which AI answers: offline (no model, always works) | claude | local
AI_PROVIDER=offline

# Cloud provider (AI_PROVIDER=claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Local provider (AI_PROVIDER=local), any OpenAI-compatible server
LOCAL_LLM_URL=http://ollama:11434/v1
LOCAL_LLM_MODEL=

# Seconds before a model answer is abandoned and the offline answer is used
PROVIDER_TIMEOUT=6
# Retrieval threshold (0-1): share of the question the best passage covers
MIN_SCORE=0.35
# Teacher view: show a question only after this many askings (set 1 for a demo and say so)
K_MIN=3

# Telegram (leave the token empty to disable the bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_STAFF_CHAT_ID=
TELEGRAM_MODE=polling

# SMS: mock (simulator, sends nothing) | africastalking
SMS_GATEWAY=mock
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# Staff console and teacher view. Use a long random value; rotate after the event.
STAFF_TOKEN=
# Optional staff hotline shown as a tap-to-call link in the help widget.
STAFF_CONTACT_PHONE=
STAFF_CONTACT_LABEL=Call support
# Key for hashing phone numbers used as session references
HMAC_SECRET=
PUBLIC_BASE_URL=http://localhost:8000
ALERT_INTERVAL_MINUTES=15

# Optional local Amharic speech transcription + translation pipeline.
# Translation endpoint is preferred when configured; otherwise local Gemma requires CUDA.
WWM_ASR_MODEL=addisai/addis-scribe-streaming
WWM_TRANSLATION_MODEL=b1n1yam/gemma-2-27b-amharic-alpaca-sft
WWM_MIN_TRANSLATION_VRAM_GB=20
WWM_TRANSLATION_MAX_NEW_TOKENS=256
HF_INFERENCE_ENDPOINT_URL=
HF_TOKEN=
SPEECH_TRANSLATION_ENABLED=0
SPEECH_MAX_UPLOAD_MB=15
SPEECH_MAX_DURATION_SECONDS=120
APP_ENV=development
# Required when APP_ENV=production and speech translation is enabled. Use a private Redis URL.
SPEECH_RATE_LIMIT_REDIS_URL=
